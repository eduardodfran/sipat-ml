SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-here
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
EXPO_PUBLIC_FASTAPI_URL=http://localhost:8000

# CORS: Add your local network IPs for React Native testing
# Example: CORS_ORIGINS=http://localhost:3000,http://192.168.1.7:19006,http://192.168.1.7:8081
# Get your IPs via `ipconfig` on Windows or `ifconfig` on Linux
CORS_ORIGINS=http://localhost:3000,http://192.168.1.7:19006,http://192.168.1.7:8081,http://192.168.1.12:19006,http://192.168.1.12:8081
# RATE_LIMIT_UPLOAD=10/hour
# RATE_LIMIT_PROCESS=5/hour
# RATE_LIMIT_READ=60/minute
# RATE_LIMIT_DELETE=10/hour
# RATE_LIMIT_HEALTH=60/minute

# Horizontal scaling
SIPAT_ML_WORKERS=4
SIPAT_ML_WORKER_TIMEOUT=120
